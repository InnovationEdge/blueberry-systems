{
  "name": "blueberry-systems",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && node scripts/prerender-locales.mjs && node scripts/check-seo.mjs",
    "typecheck": "tsc -b --noEmit",
    "check:seo": "node scripts/check-seo.mjs",
